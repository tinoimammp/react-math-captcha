# react-math-captcha — copy to .env.local

# Required
CAPTCHA_SECRET=your-super-secret-key-minimum-32-characters-long


# ── Optional — Lifecycle Tuning ───────────────────────────────────────────────

# Maximum wrong answers before the session is locked.
# CAPTCHA_MAX_ATTEMPTS=5

# Maximum times the user can request a new challenge before the session is locked.
# CAPTCHA_MAX_RELOADS=8

# How long (in seconds) a challenge is valid before it expires.
# CAPTCHA_TTL_SEC=30

# How long (in seconds) the session stays locked after too many failures.
# CAPTCHA_LOCK_SEC=60
